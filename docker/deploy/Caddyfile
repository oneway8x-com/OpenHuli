{
	admin off
	auto_https disable_redirects
}
{$OPENHULI_APP_HOST} {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	reverse_proxy app:3000
}
{$OPENHULI_RUNTIME_HOST} {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	@public path /voice /health/live /health/ready
	handle @public {
		reverse_proxy runtime:3200 {
			flush_interval -1
		}
	}
	# Owner API traffic is authenticated by the runtime. The broker bridge is never proxied.
	@owner path /console /console/* /management
	handle @owner {
		reverse_proxy runtime:3200 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}
http://127.0.0.1:8080 {
	bind 127.0.0.1
	respond /health/live 200
}
