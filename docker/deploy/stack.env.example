# Copy to ignored deployment.local/stack.env; use absolute paths for mounted files.
OPENHULI_APP_HOST=openhuli.localhost
OPENHULI_RUNTIME_HOST=runtime.openhuli.localhost
OPENHULI_MQTT_HOST=mqtt.openhuli.localhost
OPENHULI_BIND_IP=127.0.0.1
OPENHULI_HTTPS_PORT=8443
OPENHULI_MQTT_PORT=8884
OPENHULI_SECRET_DIR=./deployment.local/secrets
OPENHULI_TLS_DIR=./deployment.local/tls
OPENHULI_IMAGE=openhuli:local
OWNER_EMAIL=owner@example.test
EMAIL_FROM=owner@example.test
# Enable only after setting the runtime-only provider secret; never use a fake key for acceptance.
RUNTIME_VOICE_ENABLED=false
HTTP_WEATHER_LATITUDE=
HTTP_WEATHER_LONGITUDE=
HTTP_WEATHER_TIMEZONE=
HTTP_NOTES_URL=
HTTP_NOTES_SECRET_REF=notes-demo
AI_DAILY_BUDGET_MICROS=1000000
AI_SESSION_RESERVATION_MICROS=10000
