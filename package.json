{
  "name": "corely",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm dev:app",
    "build": "pnpm build:packages && pnpm --filter @corely/runtime build && pnpm --filter @corely/notes-api build && pnpm --filter @corely/app build",
    "build:packages": "pnpm --filter @corely/kernel --filter @corely/contracts --filter @corely/prompts --filter @corely/domain --filter @corely/data --filter @corely/storage --filter @corely/email-templates --filter \"@corely/modules-*\" build",
    "typecheck": "pnpm --filter @corely/contracts typecheck && pnpm --filter @corely/data typecheck && pnpm --filter @corely/storage typecheck && pnpm --filter \"@corely/modules-*\" typecheck && pnpm --filter @corely/runtime typecheck && pnpm --filter @corely/app typecheck && pnpm --filter @corely/e2e exec tsc --noEmit && pnpm --filter @corely/notes-api typecheck",
    "dev:app": "pnpm --filter @corely/app dev --hostname 127.0.0.1",
    "dev:runtime": "pnpm build:packages && pnpm --filter @corely/runtime dev",
    "start:runtime": "pnpm --filter @corely/runtime start",
    "build:app": "pnpm build:packages && pnpm --filter @corely/app build",
    "prisma:generate": "pnpm --filter @corely/data exec prisma generate",
    "prisma:migrate": "pnpm --filter @corely/data exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @corely/data exec prisma studio",
    "migrate": "pnpm prisma:migrate",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "kill3000": "lsof -ti:3000 | xargs kill -9",
    "arch:check": "node scripts/architecture-check.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm prompt:check",
    "prompt:check": "node scripts/check-prompts.mjs",
    "test": "pnpm test:scripts && vitest run --workspace ./vitest.workspace.ts",
    "test:unit": "pnpm test:scripts && vitest run --workspace ./vitest.workspace.ts",
    "test:int": "vitest run --workspace ./vitest.workspace.int.ts",
    "test:watch": "vitest --workspace ./vitest.workspace.ts --watch",
    "coverage": "vitest run --workspace ./vitest.workspace.ts --coverage",
    "pretypecheck": "pnpm build:packages",
    "prisma:validate": "pnpm --filter @corely/data exec prisma validate",
    "prisma:deploy": "pnpm --filter @corely/data exec prisma migrate deploy",
    "db:seed": "pnpm owner:bootstrap",
    "test:scripts": "tsx --test scripts/*.test.ts",
    "test:db:setup": "tsx scripts/setup-test-database.ts",
    "test:e2e": "pnpm --filter @corely/e2e e2e",
    "owner:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-owner.ts",
    "test:migrations": "tsx scripts/check-persistence-migrations.ts",
    "test:broker": "vitest run --workspace ./vitest.workspace.broker.ts",
    "dev:notes": "pnpm --filter @corely/notes-api dev",
    "smoke:http": "node --env-file-if-exists=.env --import tsx scripts/smoke-http-tools.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "@corely/tsconfig": "workspace:*"
  },
  "author": "Ha Doan <ha@oneway8x.com>",
  "dependencies": {
    "@google-cloud/speech": "^7.2.1",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  }
}
