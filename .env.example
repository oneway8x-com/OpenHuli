# Local Docker development. Never expose the development secret or OTP console publicly.
DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli"
# DIRECT_DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli"

# Explicit single owner. Run pnpm owner:bootstrap after applying migrations.
OWNER_EMAIL="owner@example.test"
APP_URL="http://localhost:3000"
# Server-only Next -> persistent runtime origin. HTTPS required beyond loopback.
OPENHULI_RUNTIME_HTTP_URL="http://127.0.0.1:3200"
# Empty uses a development-only key for pnpm dev. Production requires a unique random 32+ character key.
JWT_SECRET=""
# Production additionally requires verified email delivery settings.
RESEND_API_KEY=""
EMAIL_FROM=""
# Browser uses same-origin APIs; cross-origin API hosting is not supported by cookie sessions.
NEXT_PUBLIC_API_BASE_URL=""
# TEST_DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli_test"

# Persistent runtime: loopback by default; no public device/voice endpoint yet.
RUNTIME_HOST="127.0.0.1"
RUNTIME_PORT="3200"
# Optional internal ping/pong probe. Empty disables it. Generate a random token (32+ characters).
# Never send this service token to browsers, firmware, or AI providers.
RUNTIME_PROBE_TOKEN=""
# Optional broker. Plain MQTT is permitted only on loopback outside production.
# Production requires mqtts:// and trusted certificate verification.
RUNTIME_MQTT_URL=""
RUNTIME_MQTT_USERNAME=""
RUNTIME_MQTT_PASSWORD=""
RUNTIME_STARTUP_TIMEOUT_MS="5000"
RUNTIME_SHUTDOWN_TIMEOUT_MS="5000"
RUNTIME_IDLE_TIMEOUT_MS="30000"
RUNTIME_MAX_CONNECTIONS="100"

# Voice transport is opt-in. Without a runtime-only Gemini key,
# enabling voice reports unavailable readiness and rejects upgrades rather than discarding audio.
RUNTIME_VOICE_ENABLED="false"
# Server-only. Never use NEXT_PUBLIC_ or send this key to a device/browser.
GEMINI_API_KEY=""
AI_MAX_TOOL_CALLS="6"
AI_TURN_TIMEOUT_MS="25000"
# Device commands require authenticated MQTT telemetry and execution acknowledgements.
RUNTIME_COMMAND_ACK_TIMEOUT_MS="5000"
RUNTIME_VOICE_QUEUE_BYTES="21248"
RUNTIME_VOICE_QUEUE_MESSAGES="64"
RUNTIME_VOICE_BUFFERED_BYTES="65536"
RUNTIME_VOICE_OPERATION_TIMEOUT_MS="5000"
RUNTIME_VOICE_TURN_TIMEOUT_MS="30000"
RUNTIME_VOICE_SESSION_TIMEOUT_MS="600000"

# MQTT telemetry is opt-in and requires the database, broker credentials above, and private bridge.
# See docs/guides/MQTT_TELEMETRY.md. Keep the bridge token separate from MQTT credentials.
RUNTIME_MQTT_TELEMETRY_ENABLED="false"
RUNTIME_MQTT_AUTH_HOST="127.0.0.1"
RUNTIME_MQTT_AUTH_PORT="3201"
RUNTIME_MQTT_AUTH_TOKEN=""
RUNTIME_TELEMETRY_INTERVAL_SECONDS="30"
RUNTIME_TELEMETRY_RETENTION_DAYS="7"

# Registered HTTP tools. Empty location/notes URL disables that tool.
HTTP_WEATHER_LATITUDE=""
HTTP_WEATHER_LONGITUDE=""
HTTP_WEATHER_TIMEZONE=""
HTTP_WEATHER_TEMPERATURE_UNIT="celsius"
# Fixed exact endpoint; public HTTPS only unless the exact loopback demo is explicitly enabled.
HTTP_NOTES_URL=""
HTTP_NOTES_PRIVATE_DEMO="false"
HTTP_NOTES_SECRET_REF="notes-demo"
# Separate local notes demo API. Generate a random 32+ character token; keep it server-only.
NOTES_API_TOKEN=""
NOTES_API_HOST="127.0.0.1"
NOTES_API_PORT="3300"
NOTES_API_DATABASE=".local/notes.sqlite"

# Owner/operator conversation limits; shared across voice and typed sessions.
# Integer micro USD: 1,000,000 = USD 1. Reservations are never refunded, even on missing usage.
# This caps admission allocations, not the provider invoice. See docs/guides/SESSION_OPERATIONS.md.
AI_DEVICE_SESSIONS_PER_DAY="100"
AI_DEVICE_CONCURRENT_SESSIONS="2"
AI_DEVICE_AUDIO_SECONDS_PER_DAY="1800"
AI_SESSION_AUDIO_SECONDS="120"
AI_DAILY_BUDGET_MICROS="1000000"
AI_SESSION_RESERVATION_MICROS="10000"
# Both optional. Supply your current conservative modality-specific rates; no built-in price guess.
AI_INPUT_MICROS_PER_MILLION_TOKENS=""
AI_OUTPUT_MICROS_PER_MILLION_TOKENS=""
AI_OPERATIONAL_RETENTION_DAYS="7"

# Full Docker deployment uses docker/deploy/stack.env.example plus mounted secret files,
# rather than this host-development database URL. See docs/guides/DOCKER_DEPLOYMENT.md.
