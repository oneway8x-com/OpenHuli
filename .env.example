# Local Docker development. Never expose the development secret or OTP console publicly.
DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli"
# DIRECT_DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli"

# Explicit single owner. Run pnpm owner:bootstrap after applying migrations.
OWNER_EMAIL="owner@example.test"
APP_URL="http://localhost:3000"
# Empty uses a development-only key for pnpm dev. Production requires a unique random 32+ character key.
JWT_SECRET=""
# Production additionally requires verified email delivery settings.
RESEND_API_KEY=""
EMAIL_FROM=""
# Browser uses same-origin APIs; cross-origin API hosting is not supported by cookie sessions.
NEXT_PUBLIC_API_BASE_URL=""
# TEST_DATABASE_URL="postgresql://openhuli:openhuli@127.0.0.1:5434/openhuli_test"
