{
  "name": "@corely/runtime",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:live": "node --env-file-if-exists=../../.env --import tsx src/live-smoke.ts",
    "smoke:playback": "node --env-file-if-exists=../../.env --import tsx src/playback-smoke.ts",
    "simulate": "node --env-file-if-exists=../../.env --import tsx src/simulator/main.ts",
    "bridge:serial": "node --import tsx src/serial-bridge/main.ts"
  },
  "dependencies": {
    "@corely/contracts": "workspace:*",
    "mqtt": "^5.14.1",
    "ws": "8.19.0",
    "zod": "catalog:",
    "@corely/modules-voice": "workspace:*",
    "@corely/modules-devices": "workspace:*",
    "@corely/data": "workspace:*",
    "@corely/modules-conversations": "workspace:*",
    "@corely/modules-tool-execution": "workspace:*",
    "@corely/modules-identity": "workspace:*",
    "@corely/modules-telemetry": "workspace:*",
    "@prisma/client": "catalog:",
    "@corely/modules-device-commands": "workspace:*",
    "@corely/modules-http-tools": "workspace:*",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@corely/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "tsx": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@corely/modules-notes": "workspace:*",
    "mqtt-packet": "9.0.2"
  }
}
